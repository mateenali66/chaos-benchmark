# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfplan
terraform/.terraform.lock.hcl
terraform/terraform.tfstate.d/

# Experiment data (large JSON/CSV files in subdirectories)
data/**/*.json
data/*.json
data/*.csv
data/*.parquet
data/progress.log
!data/.gitkeep

# Revision-campaign experiment output (data-v2/): same rationale as data/
# above -- large per-run JSON + gzipped timeseries sidecars, not source.
# Code/config under data-v2 is never expected; this excludes the whole tree.
data-v2/*
!data-v2/README.md

# One-off pilot/validation runs (see data-v2/README.md for why these must
# never live under data-v2/) -- also experiment output, not source.
pilots/

# Credentials and secrets
*.pem
*.key
*.env
gremlin-credentials.yaml

# OS
.DS_Store
Thumbs.db

# DeathStarBench submodule (tracked by .gitmodules, don't ignore)

# Python
__pycache__/
*.pyc
.venv/

# IDE
.idea/
.vscode/
*.swp

# LaTeX build artifacts
*.aux
*.log
*.out
*.synctex.gz

# Screenshots (internal only)
screenshots/

# Terraform variables (contains AWS account IDs)
terraform/terraform.tfvars

# Project notes
CLAUDE.md
