# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfplan
terraform/.terraform.lock.hcl
terraform/terraform.tfstate.d/

# Experiment data (large JSON/CSV files in subdirectories)
data/**/*.json
data/*.json
data/*.csv
data/*.parquet
data/progress.log
!data/.gitkeep

# Experiment output (data-v2/): large per-run JSON and gzipped timeseries
# sidecars, archived on Zenodo. Only its README is tracked.
data-v2/*
!data-v2/README.md

# Pilot and validation runs, kept out of data-v2/ so analysis globs never
# match them.
pilots/

# Credentials and secrets
*.pem
*.key
*.env
gremlin-credentials.yaml
litmus-credentials.json

# OS
.DS_Store
Thumbs.db

# DeathStarBench is a submodule (.gitmodules), not ignored.

# Python
__pycache__/
*.pyc
.venv/

# IDE
.idea/
.vscode/
*.swp

# LaTeX build artifacts
*.aux
*.log
*.out
*.synctex.gz
# data/exclusions.log is the exclusion record required by
# analysis/PREREGISTRATION.md ("Exclusion and rerun rules"), so keep it tracked.
!data/exclusions.log

# Screenshots
screenshots/

# Terraform variables (contains AWS account IDs)
terraform/terraform.tfvars

# Local notes
CLAUDE.md
